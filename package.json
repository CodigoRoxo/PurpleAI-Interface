{
  "name": "purpleai-interface",
  "version": "1.0.0",
  "private": true,
  "description": "Local, modern, developer-focused web interface for Ollama models",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"magenta,cyan\" \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=backend && npm run build --workspace=frontend",
    "start": "npm run start --workspace=backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "ollama",
    "rag",
    "local-llm",
    "ai",
    "react",
    "typescript",
    "vector-search",
    "code-assistant",
    "developer-tools",
    "self-hosted",
    "private-ai"
  ],
  "license": "MIT",
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  }
}
