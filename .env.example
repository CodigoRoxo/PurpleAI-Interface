# Server Configuration
# 127.0.0.1 keeps the API private to this machine. To expose it on your network
# (HOST=0.0.0.0) you MUST also set PURPLEAI_API_TOKEN.
PORT=3001
HOST=127.0.0.1

# Ollama Engine URL (Default: http://localhost:11434)
OLLAMA_HOST=http://localhost:11434

# Embedding Model for RAG (Default: all-minilm)
# Make sure to run `ollama pull all-minilm` or `ollama pull nomic-embed-text`
EMBEDDING_MODEL=all-minilm

# Security (optional)
# PURPLEAI_API_TOKEN=a-long-random-secret
# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# ALLOWED_HOSTS=127.0.0.1,localhost,::1
# Terminal commands default to enabled on 127.0.0.1 and disabled otherwise
# ALLOW_SHELL_COMMANDS=true
